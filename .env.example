# Copy this file to .env.local and fill in your values

# Supabase Auth — use the same project as FTC Contacts so accounts are shared
# Supabase project → Settings → API → Project URL & anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# OpenAI — used for Whisper audio transcription
OPENAI_API_KEY=sk-...

# Anthropic — used for Claude AI summarisation
ANTHROPIC_API_KEY=sk-ant-...

# Groq — FREE alternative to OpenAI for Whisper transcription (console.groq.com)
GROQ_API_KEY=gsk_...

# Database — Supabase PostgreSQL connection string
# Supabase project → Settings → Database → URI
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Vercel Cron auth secret (required in production for /api/jobs/finalize)
CRON_SECRET=choose_a_long_random_secret

# Airtable backup (optional — recordings are backed up here after processing)
# Create a personal access token at airtable.com/create/tokens
# Base needs a table called "Recordings" — see lib/airtable-backup.ts for the fields
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ── Transcription language ───────────────────────────────────────────────────
# Whisper re-detects the language on every chunk, and a chunk of near-silence
# can detect as anything — which is how a Google Meet transcript ended up with
# a Ukrainian cookery sign-off attributed to the account holder. Pinning it
# removes that entire class of invented speech. Set to `auto` to restore
# detection, or to another ISO 639-1 code for a non-English customer.
TRANSCRIBE_LANGUAGE=en

# ── Chrome extension ─────────────────────────────────────────────────────────
# Comma-separated 32-character extension IDs allowed to call this API
# cross-origin. An unpacked extension gets a new ID on every load, so in
# development the check is relaxed automatically and this can stay empty.
EXTENSION_IDS=
# Baked into the /extension connect page so users do not have to paste an ID.
NEXT_PUBLIC_EXTENSION_ID=

# ── Recall.ai meeting bots (optional) ────────────────────────────────────────
# Without RECALL_API_KEY the bot option is hidden entirely and nothing else
# changes. With it, a bot can join a Teams/Meet/Zoom/Webex call and return a
# separate audio stream per participant — the only path where speaker
# attribution is exact rather than inferred.
RECALL_API_KEY=
RECALL_REGION=eu-west-1
# Recall signs its webhooks (Svix). The webhook route FAILS CLOSED without
# this, so bots will not complete until it is set.
RECALL_WEBHOOK_SECRET=
# Where Recall should send webhooks. Must be publicly reachable — on localhost
# use a tunnel (e.g. `npx untun` or ngrok) rather than http://localhost:3000.
PUBLIC_APP_URL=
