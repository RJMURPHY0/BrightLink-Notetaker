{
  "manifest_version": 3,
  "name": "BrightLink Notetaker",
  "version": "0.1.0",
  "description": "One-click meeting recording with real speaker names, for Teams, Meet and Zoom.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/*",
    "https://*.webex.com/*",
    "https://app.slack.com/*",
    "https://notetaker.brightlink.io/*",
    "https://ftctranscribe-phi.vercel.app/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrightLink Notetaker",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*",
        "https://*.webex.com/*",
        "https://app.slack.com/*"
      ],
      "js": [
        "content/participants.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://notetaker.brightlink.io/*",
      "https://ftctranscribe-phi.vercel.app/*",
      "http://localhost/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html",
        "permission.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
